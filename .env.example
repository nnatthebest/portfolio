# Copy to .env for local work. Never commit .env. Only PUBLIC_* values reach the browser.
# On Cloudflare Pages set the same name under Settings → Variables and Secrets (used at build time).

# Cloudflare Turnstile site key. The value below is Cloudflare's dummy key that always passes;
# it works on localhost for testing. Use the real site key in production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secrets of the contact form function (RESEND_API_KEY, TURNSTILE_SECRET_KEY, CONTACT_TO,
# CONTACT_FROM) are NOT stored here. See .dev.vars.example and docs/contact-form.md.
