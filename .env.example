# Copy to .env for local work. Never commit .env. Only PUBLIC_* values reach the browser.
# On Cloudflare Pages set the same names under Settings → Environment variables.

# Production URL of the n8n Webhook node (see docs/n8n-workflow.md).
PUBLIC_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/portfolio-contact

# Cloudflare Turnstile site key. The value below is Cloudflare's dummy key that always passes;
# it works on localhost only for testing. Use the real site key in production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The Turnstile SECRET key is NOT stored here. It belongs in an n8n credential.
