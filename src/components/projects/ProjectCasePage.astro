---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Button from '../Button.astro';
import Container from '../Container.astro';
import FinalCta from '../FinalCta.astro';
import Section from '../Section.astro';
import { homeCopy, projectTypeLabels, projectsCopy } from '../../i18n/copy';
import { projectPath, route, type Lang } from '../../i18n/ui';
import { getNextProject } from '../../lib/content';
import { splitEntryId } from '../../lib/content-utils';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const { data } = entry;
const copy = projectsCopy[lang].case;

const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const hasResults = data.results.length > 0;
// Concepts have no real numbers: the brief asks for "what the owner gets" instead.
const resultHeading = !hasResults && data.concept ? copy.ownerGets : copy.result;

const typeLabel = projectTypeLabels[lang][data.type];
const label = data.concept ? `${homeCopy[lang].featured.conceptLabel} · ${typeLabel}` : typeLabel;

const next = await getNextProject(lang, entry.id);
---

<article>
  <Container class="pt-8 md:pt-12">
    <a
      href={route(lang, 'projects')}
      class="inline-flex min-h-11 items-center text-sm font-medium text-muted underline decoration-line decoration-2 underline-offset-4 hover:text-fg hover:decoration-accent-text"
    >
      {copy.back}
    </a>
    <p class="mt-6 text-sm font-medium text-muted">{label}</p>
    <h1 class="mt-3 max-w-4xl text-4xl sm:text-5xl md:text-6xl">{data.title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">{data.summary}</p>

    {data.concept && (
      <p class="mt-6 max-w-2xl border-l-2 border-accent pl-4 text-sm">{copy.conceptNotice}</p>
    )}

    <dl class="mt-10 grid gap-x-10 gap-y-6 text-sm sm:grid-cols-[auto_auto_1fr]">
      <div>
        <dt class="text-muted">{copy.year}</dt>
        <dd class="mt-1 font-medium">{data.year}</dd>
      </div>
      {data.client && (
        <div>
          <dt class="text-muted">{copy.client}</dt>
          <dd class="mt-1 font-medium">{data.client}</dd>
        </div>
      )}
      <div>
        <dt class="text-muted">{copy.stack}</dt>
        <dd>
          <ul class="mt-1 flex flex-wrap gap-2">
            {data.stack.map((item) => (
              <li class="rounded-ui border border-line px-2.5 py-1 text-muted">{item}</li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>

    {(data.demoUrl || data.repoUrl) && (
      <div class="mt-8 flex flex-wrap gap-3">
        {data.demoUrl && <Button href={data.demoUrl}>{copy.demo}</Button>}
        {data.repoUrl && (
          <Button href={data.repoUrl} variant="secondary">
            {copy.code}
          </Button>
        )}
      </div>
    )}
  </Container>

  <Container class="mt-10">
    <Image
      src={data.cover}
      alt={data.title}
      widths={[640, 1024, 1536]}
      sizes="(min-width: 1152px) 1088px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full rounded-ui border border-line"
    />
  </Container>

  <Section id="brief" number="01" heading={copy.brief} class="mt-16 md:mt-24">
    <p class="max-w-3xl text-xl md:text-2xl">{data.problem}</p>
  </Section>

  <Section id="solution" number="02" heading={copy.solution}>
    <p class="max-w-3xl text-xl md:text-2xl">{data.solution}</p>
  </Section>

  {(hasResults || hasBody) && (
    <Section id="result" number="03" heading={resultHeading}>
      {hasResults && (
        <dl class="mb-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {data.results.map((result) => (
            <div class="flex flex-col-reverse border-t border-fg pt-4">
              <dt class="mt-2 text-muted">{result.label}</dt>
              <dd class="font-display text-5xl font-semibold tracking-tight">{result.value}</dd>
            </div>
          ))}
        </dl>
      )}
      {hasBody && (
        <div class="prose-lite max-w-2xl text-lg">
          <Content />
        </div>
      )}
    </Section>
  )}

  {data.gallery && data.gallery.length > 0 && (
    <Section id="gallery" heading={copy.gallery}>
      <ul class="grid gap-6 md:grid-cols-2">
        {data.gallery.map((image, index) => (
          <li>
            <Image
              src={image}
              alt={`${data.title}, ${index + 1}`}
              widths={[480, 960]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="w-full rounded-ui border border-line"
            />
          </li>
        ))}
      </ul>
    </Section>
  )}

  {next && (
    <Container class="border-t border-line py-12">
      <a
        href={projectPath(lang, splitEntryId(next.id).slug)}
        class="group block min-h-11 border-t border-fg pt-6"
      >
        <p class="text-sm text-muted">{copy.next}</p>
        <p class="mt-1 font-display text-3xl font-semibold tracking-tight group-hover:text-accent-text md:text-4xl">
          {next.data.title} →
        </p>
      </a>
    </Container>
  )}

  <FinalCta lang={lang} />
</article>
