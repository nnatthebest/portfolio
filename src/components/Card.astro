---
interface Props {
  /** Makes the whole card a link. */
  href?: string;
  as?: 'div' | 'article' | 'li';
  class?: string;
}

const { href, as = 'div', class: className = '' } = Astro.props;
const Tag = href ? 'a' : as;
const isExternal = href !== undefined && /^https?:\/\//.test(href);
---

<Tag
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class:list={[
    'ticks block rounded-ui border border-line bg-bg p-5 md:p-6',
    href && 'transition-colors duration-150 hover:border-fg',
    className,
  ]}
>
  <slot />
</Tag>
