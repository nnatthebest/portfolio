---
import Button from './Button.astro';
import Container from './Container.astro';
import LangSwitch from './LangSwitch.astro';
import Monogram from './Monogram.astro';
import { site } from '../config';
import { otherLang, route, t, type Lang, type RouteKey, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Equivalent URLs of the current page per language; falls back to the other language's home. */
  alternates?: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;

const navItems: { route: RouteKey; label: UiKey }[] = [
  { route: 'services', label: 'navServices' },
  { route: 'projects', label: 'navProjects' },
  { route: 'about', label: 'navAbout' },
  { route: 'contact', label: 'navContact' },
];

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
const links = navItems.map((item) => {
  const href = route(lang, item.route);
  return { href, label: t(lang, item.label), current: normalize(href) === currentPath };
});

const homeHref = route(lang, 'home');
const switchHref = alternates?.[otherLang(lang)] ?? route(otherLang(lang), 'home');
const navLinkClass =
  'inline-flex min-h-11 items-center font-medium text-fg underline decoration-transparent decoration-2 underline-offset-4 transition-colors duration-150 hover:decoration-accent-text aria-[current=page]:decoration-accent-text';
---

<header class="sticky top-0 z-40 border-b border-line bg-bg">
  <Container class="flex h-16 items-center justify-between gap-4">
    <a href={homeHref} class="flex min-h-11 items-center gap-3 text-fg">
      <span aria-hidden="true">
        <Monogram size={32} />
      </span>
      <span class="font-display text-sm font-semibold tracking-tight sm:text-base">
        {site.name}
      </span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      <nav aria-label={t(lang, 'mainNav')}>
        <ul class="flex items-center gap-6">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.current ? 'page' : undefined}
                class={navLinkClass}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <LangSwitch lang={lang} href={switchHref} />
      <Button href={site.calConsultation} size="sm">
        {t(lang, 'ctaConsultation')}
      </Button>
    </div>

    <details id="mobile-menu" class="group md:hidden">
      <summary
        aria-label={t(lang, 'menu')}
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-ui border border-line text-fg [&::-webkit-details-marker]:hidden"
      >
        <svg
          class="group-open:hidden"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 6h14M3 14h14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg
          class="hidden group-open:block"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4.5 4.5l11 11M15.5 4.5l-11 11"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
      </summary>
      <div class="absolute inset-x-0 top-full border-b border-line bg-bg">
        <Container class="py-4">
          <nav aria-label={t(lang, 'mainNav')}>
            <ul class="flex flex-col divide-y divide-line">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.current ? 'page' : undefined}
                    class="flex min-h-12 items-center text-lg font-medium text-fg aria-[current=page]:text-accent-text"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="mt-4 flex items-center gap-3">
            <Button href={site.calConsultation} class="flex-1">
              {t(lang, 'ctaConsultation')}
            </Button>
            <LangSwitch lang={lang} href={switchHref} class="min-h-11" />
          </div>
        </Container>
      </div>
    </details>
  </Container>
</header>

<script>
  // Close the mobile menu with Escape and return focus to its toggle.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const menu = document.querySelector<HTMLDetailsElement>('#mobile-menu');
    if (!menu?.open) return;
    menu.open = false;
    menu.querySelector('summary')?.focus();
  });
</script>
