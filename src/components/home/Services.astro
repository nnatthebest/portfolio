---
import type { CollectionEntry } from 'astro:content';
import Card from '../Card.astro';
import Section from '../Section.astro';
import { homeCopy } from '../../i18n/copy';
import type { Lang } from '../../i18n/ui';
import { formatPrice } from '../../lib/format';

interface Props {
  lang: Lang;
  number: string;
  services: readonly CollectionEntry<'services'>[];
}

const { lang, number, services } = Astro.props;
const copy = homeCopy[lang].services;
---

{services.length > 0 && (
  <Section id="services" number={number} heading={copy.heading}>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <li>
          <Card class="h-full">
            <div class="flex h-full flex-col">
              <h3 class="text-xl">{service.data.title}</h3>
              <p class="mt-4 font-display text-3xl font-semibold tracking-tight">
                {copy.from} {formatPrice(lang, service.data.priceFrom)}
              </p>
              <p class="mt-1 text-sm text-muted">{service.data.duration}</p>
              <ul class="mt-5 space-y-2 text-[0.95rem]">
                {service.data.includes.map((item) => (
                  <li class="relative pl-4 before:absolute before:left-0 before:text-muted before:content-['–']">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </Card>
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-2xl text-muted">{copy.vatNote}</p>
    <p class="mt-2 max-w-2xl text-muted">{copy.promo}</p>
  </Section>
)}
