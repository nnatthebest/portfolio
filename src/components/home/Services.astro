---
import type { CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import ServiceCard from '../ServiceCard.astro';
import { homeCopy } from '../../i18n/copy';
import type { Lang } from '../../i18n/ui';
import { formatPrice } from '../../lib/format';

interface Props {
  lang: Lang;
  number: string;
  services: readonly CollectionEntry<'services'>[];
}

const { lang, number, services } = Astro.props;
const copy = homeCopy[lang].services;
---

{services.length > 0 && (
  <Section id="services" number={number} heading={copy.heading}>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <li>
          <ServiceCard
            title={service.data.title}
            price={`${copy.from} ${formatPrice(lang, service.data.priceFrom)}`}
            duration={service.data.duration}
            includes={service.data.includes}
          />
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-2xl text-muted">{copy.vatNote}</p>
    <p class="mt-2 max-w-2xl text-muted">{copy.promo}</p>
  </Section>
)}
