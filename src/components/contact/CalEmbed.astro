---
import Button from '../Button.astro';
import { site } from '../../config';
import { contactCopy } from '../../i18n/copy';
import type { Lang } from '../../i18n/ui';
import { calLinkFromUrl, calNamespaceFromLink } from '../../lib/cal';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = contactCopy[lang].cal;

const calLink = calLinkFromUrl(site.calConsultation);
const namespace = calNamespaceFromLink(calLink);
const linkClass = 'text-accent-text underline decoration-1 underline-offset-4 hover:decoration-2';
---

<div data-cal-embed data-cal-link={calLink} data-cal-namespace={namespace}>
  <h2 class="text-3xl md:text-4xl">{copy.heading}</h2>
  <p class="mt-3 max-w-xl text-muted">{copy.text}</p>

  <div class="mt-6">
    <Button data-cal-open aria-controls="cal-inline" aria-expanded="false">
      {copy.button}
    </Button>
  </div>

  <div id="cal-inline" tabindex="-1" data-cal-container hidden class="mt-8">
    <p data-cal-status class="text-sm text-muted">
      {copy.loading}
    </p>
  </div>

  <p class="mt-4 text-sm">
    <a href={site.calConsultation} target="_blank" rel="noopener noreferrer" class={linkClass}>
      {copy.fallback}
    </a>
  </p>
</div>

<script>
  // The Cal.com embed script is fetched only after the visitor asks for the calendar.
  // `loadCalLoader` is a port of the loader snippet Cal.com generates: calls made before
  // embed.js arrives are queued, and the first call appends the script tag.
  type CalCall = (...args: unknown[]) => void;
  type CalQueue = { q?: unknown[] };
  type CalNamespace = CalCall & CalQueue;
  type CalApi = CalCall & CalQueue & { loaded?: boolean; ns: Record<string, CalNamespace> };

  declare global {
    interface Window {
      Cal?: CalApi;
    }
  }

  const CAL_SCRIPT = 'https://app.cal.com/embed/embed.js';
  const CAL_ORIGIN = 'https://cal.com';

  function enqueue(target: CalQueue, args: unknown) {
    // embed.js reads these queues when it loads, so they are filled in place on purpose.
    (target.q ??= []).push(args);
  }

  function loadCalLoader(): CalApi {
    if (window.Cal) return window.Cal;

    const cal = ((...args: unknown[]) => {
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q ?? [];
        const script = document.createElement('script');
        script.src = CAL_SCRIPT;
        document.head.appendChild(script);
        cal.loaded = true;
      }

      if (args[0] === 'init') {
        const api = ((...apiArgs: unknown[]) => enqueue(api, apiArgs)) as CalNamespace;
        api.q = api.q ?? [];
        const namespace = args[1];
        if (typeof namespace === 'string') {
          const target = cal.ns[namespace] ?? api;
          cal.ns[namespace] = target;
          enqueue(target, args);
          enqueue(cal, ['initNamespace', namespace]);
        } else {
          enqueue(cal, args);
        }
        return;
      }

      enqueue(cal, args);
    }) as CalApi;

    window.Cal = cal;
    return cal;
  }

  function initCalEmbed(root: HTMLElement) {
    const opener = root.querySelector<HTMLButtonElement>('[data-cal-open]');
    const container = root.querySelector<HTMLElement>('[data-cal-container]');
    const status = root.querySelector<HTMLElement>('[data-cal-status]');
    const calLink = root.dataset.calLink;
    const namespace = root.dataset.calNamespace;
    if (!opener || !container || !calLink || !namespace) return;

    opener.addEventListener(
      'click',
      () => {
        container.hidden = false;
        opener.setAttribute('aria-expanded', 'true');
        opener.hidden = true;
        container.focus();

        // The loading note goes away as soon as the calendar frame appears.
        const observer = new MutationObserver(() => {
          if (container.querySelector('iframe, cal-inline')) {
            status?.remove();
            observer.disconnect();
          }
        });
        observer.observe(container, { childList: true, subtree: true });

        const cal = loadCalLoader();
        cal('init', namespace, { origin: CAL_ORIGIN });
        const api = cal.ns[namespace];
        api?.('inline', {
          elementOrSelector: container,
          calLink,
          config: { layout: 'month_view', theme: 'auto' },
        });
        api?.('ui', { hideEventTypeDetails: false, layout: 'month_view' });
      },
      { once: true },
    );
  }

  const root = document.querySelector<HTMLElement>('[data-cal-embed]');
  if (root) initCalEmbed(root);
</script>
