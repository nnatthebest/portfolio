---
import Container from '../Container.astro';
import Section from '../Section.astro';
import CalEmbed from './CalEmbed.astro';
import ContactForm from './ContactForm.astro';
import { site } from '../../config';
import { contactCopy } from '../../i18n/copy';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = contactCopy[lang];

const directLinks = [
  { text: site.email, href: `mailto:${site.email}`, external: false },
  { text: copy.page.whatsappLabel, href: site.whatsapp, external: true },
  { text: copy.page.linkedinLabel, href: site.linkedin, external: true },
];
const linkClass =
  'inline-flex min-h-8 items-center text-fg underline decoration-line decoration-2 underline-offset-4 transition-colors duration-150 hover:decoration-accent-text';
---

<Container class="pt-16 pb-10 md:pt-24">
  <h1 class="text-5xl md:text-7xl">{copy.page.title}</h1>
  <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">{copy.page.intro}</p>
</Container>

<Container class="pb-16 md:pb-24">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-16">
    <div>
      <h2 class="mb-6 text-3xl md:text-4xl">{copy.form.heading}</h2>
      <ContactForm lang={lang} />
    </div>

    <aside aria-labelledby="direct-heading">
      <h2 id="direct-heading" class="mb-4 text-sm font-medium tracking-wide text-muted uppercase">
        {copy.page.directHeading}
      </h2>
      <ul class="space-y-1">
        {directLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={linkClass}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</Container>

<Section id="calendar">
  <CalEmbed lang={lang} />
</Section>
