---
import Container from './Container.astro';

interface Props {
  id?: string;
  /** Section number shown above the heading, e.g. "01". */
  number?: string;
  heading?: string;
  class?: string;
}

const { id, number, heading, class: className = '' } = Astro.props;
const headingId = heading && id ? `${id}-heading` : undefined;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['reveal border-t border-line py-16 md:py-24', className]}
>
  <Container>
    {(number || heading) && (
      <header class="mb-10 md:mb-14">
        {number && (
          <p class="mb-3 font-sans text-sm font-medium tracking-wide text-muted tabular-nums">
            {number}
          </p>
        )}
        {heading && (
          <h2 id={headingId} class="text-3xl md:text-5xl">
            {heading}
          </h2>
        )}
      </header>
    )}
    <slot />
  </Container>
</section>
