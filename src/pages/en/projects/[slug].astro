---
import type { InferGetStaticPropsType } from 'astro';
import ProjectCasePage from '../../../components/projects/ProjectCasePage.astro';
import { getLang, projectPath } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjectStaticPaths } from '../../../lib/content';
import { splitEntryId } from '../../../lib/content-utils';
import { buildProjectJsonLd } from '../../../lib/jsonld';
import { projectMetaTitle } from '../../../lib/meta';
import { getOgImage } from '../../../lib/og';

export async function getStaticPaths() {
  return getProjectStaticPaths('en');
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const lang = getLang(Astro.currentLocale);
const ogImage = await getOgImage(entry.data.cover);

const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const absolute = (path: string) => new URL(path, origin).href;
const jsonLd = buildProjectJsonLd({
  origin,
  url: absolute(projectPath(lang, splitEntryId(entry.id).slug)),
  lang,
  title: entry.data.title,
  description: entry.data.summary,
  year: entry.data.year,
  stack: entry.data.stack,
  imageUrl: absolute(ogImage.src),
  concept: entry.data.concept,
});
---

<BaseLayout
  title={projectMetaTitle(lang, entry.data)}
  description={entry.data.summary}
  image={ogImage}
  jsonLd={[jsonLd]}
>
  <ProjectCasePage entry={entry} lang={lang} />
</BaseLayout>
