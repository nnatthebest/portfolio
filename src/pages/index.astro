---
import HomePage from '../components/home/HomePage.astro';
import { homeCopy } from '../i18n/copy';
import { getLang } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildHomeJsonLd } from '../lib/jsonld';

const lang = getLang(Astro.currentLocale);
const { title, description } = homeCopy[lang].meta;
const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[buildHomeJsonLd({ origin, lang, description })]}
>
  <HomePage lang={lang} />
</BaseLayout>
