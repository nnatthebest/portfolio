---
import HomePage from '../components/home/HomePage.astro';
import { site } from '../config';
import { getLang, t } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = getLang(Astro.currentLocale);
---

<BaseLayout title={site.name} description={t(lang, 'tagline')}>
  <HomePage lang={lang} />
</BaseLayout>
