---
import ServicesPage from '../../components/services/ServicesPage.astro';
import { site } from '../../config';
import { servicesCopy } from '../../i18n/pages-copy';
import { getLang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = getLang(Astro.currentLocale);
const copy = servicesCopy[lang];
---

<BaseLayout title={`${copy.title} — ${site.name}`} description={copy.description}>
  <ServicesPage lang={lang} />
</BaseLayout>
