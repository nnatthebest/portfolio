---
import ProjectsPage from '../../components/projects/ProjectsPage.astro';
import { site } from '../../config';
import { projectsCopy } from '../../i18n/copy';
import { getLang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = getLang(Astro.currentLocale);
const copy = projectsCopy[lang].list;
---

<BaseLayout title={`${copy.title} — ${site.name}`} description={copy.description}>
  <ProjectsPage lang={lang} />
</BaseLayout>
